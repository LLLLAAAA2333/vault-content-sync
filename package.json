{
	"name": "vault-content-sync",
	"version": "0.4.2",
	"description": "Desktop Obsidian plugin for WebDAV content verification and conservative three-way text merging",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@10.17.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm typecheck && node tools/build.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "pnpm lint && pnpm lint:community && pnpm build && node tools/check-boundaries.mjs",
		"test": "vitest run && node --test tools/*.test.mjs",
		"demo": "node tools/demo.mjs",
		"e2e": "node tools/obsidian-e2e.mjs",
		"probe": "node tools/probe.mjs",
		"check:release": "pnpm check && node tools/check-release.mjs",
		"lint:community": "eslint src --max-warnings 1"
	},
	"dependencies": {
		"@jest/diff-sequences": "30.5.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@types/node": "22.20.1",
		"esbuild": "0.25.12",
		"eslint": "10.14.0",
		"eslint-plugin-obsidianmd": "0.5.1",
		"jsdom": "30.1.2",
		"obsidian": "1.13.1",
		"playwright-core": "1.63.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vitest": "4.1.11"
	}
}
